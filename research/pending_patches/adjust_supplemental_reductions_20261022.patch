+# 2026-10-22 先.一三〇-3／收件匣 017：官方減資補充事件（2007～2014）。FinMind 減資表本機快取 2010 年起且有漏（1441 2010-10），
+# 上櫃沒有官方減資參考價表；由 research/var1018_v1_reduction_events.py 產生（TWSE TWTAUU 2011 起；2007～2010 與上櫃用
+# 「恢復買賣日官方收盤 − 漲跌」推導參考價），係數＝參考價 ÷ 停止買賣前收盤。只補 FinMind 沒有的事件（同股 ±7 天內已有
+# 減資／面額變更事件就不加），只影響事件日以前的還原價，2015 以後的還原結果不變。檔案不存在＝不補（十二節 fail open）。
+SUPPLEMENTAL_REDUCTIONS = Path(__file__).resolve().parent / "data" / "v1_reduction_events_2007_2014.csv"
+_SUPP_CACHE: dict | None = None
+_SUPP_DEDUP_DAYS = 7
+
+
+def _supplemental_reduction_events(stock_id: str) -> list[dict]:
+    global _SUPP_CACHE
+    if _SUPP_CACHE is None:
+        _SUPP_CACHE = {}
+        try:
+            if SUPPLEMENTAL_REDUCTIONS.exists():
+                df = pd.read_csv(SUPPLEMENTAL_REDUCTIONS, dtype={"stock_id": str})
+                for r in df[df["kind"] == "reduction"].itertuples():
+                    if r.factor > 0:
+                        _SUPP_CACHE.setdefault(r.stock_id, []).append({
+                            "ex_date": str(r.resume_date), "prev_trading_date": None, "factor": float(r.factor),
+                            "cash": 0.0, "stock_ratio": 0.0, "event_type": "capital_reduction_official_supp"})
+        except Exception as e:  # noqa: BLE001 — 補充檔壞掉只降級成不補（十二節）
+            print(f"[adjust] 警告：官方減資補充檔讀取失敗（{type(e).__name__}: {e}），本次不補", file=sys.stderr)
+            _SUPP_CACHE = {}
+    return list(_SUPP_CACHE.get(stock_id, []))
+
+
+def _merge_supplemental_reductions(ev: pd.DataFrame, supp: list[dict], start_date: str) -> pd.DataFrame:
+    if not supp:
+        return ev
+    have = pd.to_datetime(ev.loc[ev["event_type"].isin(["capital_reduction", "par_value_change"]), "ex_date"]) \
+        if len(ev) and "event_type" in ev.columns else pd.Series([], dtype="datetime64[ns]")
+    add = [e for e in supp if e["ex_date"] >= start_date
+           and not (len(have) and (abs(have - pd.Timestamp(e["ex_date"])) <= pd.Timedelta(days=_SUPP_DEDUP_DAYS)).any())]
+    if not add:
+        return ev
+    out = pd.concat([ev, pd.DataFrame(add)], ignore_index=True) if len(ev) else pd.DataFrame(add)
+    return out.sort_values("ex_date").reset_index(drop=True)
 
 
